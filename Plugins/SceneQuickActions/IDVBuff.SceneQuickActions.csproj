<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>IDVBuff.Plugins.SceneQuickActions</RootNamespace>
    <AssemblyName>IDVB.SceneQuickActions</AssemblyName>
    <PackageId>IdentityVisionBridge.SceneQuickActions</PackageId>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="IDVBuff.PluginContracts.Tests" />
    <InternalsVisibleTo Include="BagAssistProbe" />
    <ProjectReference Include="..\..\IDVBuff.PluginContracts\IDVBuff.PluginContracts.csproj" />
    <ProjectReference Include="..\..\IDVBuff.PluginHostMessages\IDVBuff.PluginHostMessages.csproj" />
    <!-- IGameOverlayToast（游戏内浮层提示）：总开关热键切换时给一条提示，与「九歌自用」同一条 Core 契约。 -->
    <ProjectReference Include="..\..\Core\IDVBuff.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- 只取托管封装；原生 OpenCvSharpExtern.dll 由主程序输出目录提供。 -->
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260627" />
  </ItemGroup>
  <ItemGroup>
    <!-- 场景识别模板（由用户提供的游戏截图裁剪）。 -->
    <EmbeddedResource Include="Templates\*.png" />
    <EmbeddedResource Include="Resources\InventoryCoordinates.json"
                      LogicalName="IDVB.SceneQuickActions.InventoryCoordinates.json" />
  </ItemGroup>
</Project>
